{
  "name": "wardley-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests examples *.ts *.json *.html *.md docs .github scripts/*.mjs",
    "format:check": "prettier --check src tests examples *.ts *.json *.html *.md docs .github scripts/*.mjs",
    "test:api:native": "python scripts/test-native-api.py",
    "check": "npm run format:check && npm run build && npm test",
    "desktop:build:core": "node scripts/build-core.mjs",
    "test:e2e:core": "playwright test --config playwright.core.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "markdown-it": "^15.0.3"
  },
  "description": "Native Wardley map editor with JSON workspaces, a local API and optional AI assistance",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
